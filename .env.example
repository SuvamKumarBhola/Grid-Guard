# GridGuard Runtime Configuration

# Environment: development | staging | production | test
GRIDGUARD_ENV=development
GRIDGUARD_DEBUG=false
GRIDGUARD_API_V1_PREFIX=/api/v1
GRIDGUARD_HOST=0.0.0.0
GRIDGUARD_PORT=8000

# Model Integration Mode: stub | artifact | fallback
GRIDGUARD_MODEL_MODE=stub
GRIDGUARD_MODEL_DIR=model_artifacts/registered/gridguard-risk-0.1.0
GRIDGUARD_REQUIRE_APPROVED_MODEL=false
GRIDGUARD_ENABLE_CHECKSUM_VALIDATION=false

# Safety Policy & Fallback Thresholds
GRIDGUARD_MIN_SENSOR_HEALTH=0.75
GRIDGUARD_FEATURE_FRESHNESS_MAX_SECONDS=300
GRIDGUARD_MAX_INFERENCE_LATENCY_MS=900
GRIDGUARD_DRIFT_THRESHOLD=0.35
GRIDGUARD_MIN_CONFIDENCE_THRESHOLD=0.60

# Security & Authentication
# Modes: development | oidc
GRIDGUARD_AUTH_MODE=development
GRIDGUARD_AUTH_SECRET=dev-secret-key-change-in-production-32b
GRIDGUARD_OIDC_ISSUER=https://auth.gridguard.internal/realms/gridguard
GRIDGUARD_OIDC_AUDIENCE=gridguard-api

# Observability & Logging
GRIDGUARD_LOG_LEVEL=INFO
GRIDGUARD_LOG_FORMAT=json

# Storage
GRIDGUARD_STORAGE_BACKEND=memory
GRIDGUARD_STORAGE_SQLITE_PATH=./data/gridguard.db
